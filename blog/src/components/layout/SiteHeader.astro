---
import LanguageSwitcher from '@components/LanguageSwitcher.astro';
import NavLinks from '@components/layout/NavLinks.astro';

type NavItem = {
  id: string;
  href: string;
  label: string;
};

type LanguageOption = {
  code: string;
  label: string;
  displayLabel: string;
  href: string;
  isActive: boolean;
  isAvailable: boolean;
};

interface SiteHeaderProps {
  lang: string;
  homeHref: string;
  navItems: NavItem[];
  languageOptions: LanguageOption[];
  showSearch: boolean;
  enableDarkMode: boolean;
}

const {
  lang,
  homeHref,
  navItems,
  languageOptions,
  showSearch,
  enableDarkMode,
}: SiteHeaderProps = Astro.props;

const postsHref = `${homeHref}#posts`;
const contactHref = `${homeHref}#contact`;
---
<header class="header">
  <div class="cont flex">
    <nav class="header__cartoon-nav" aria-label="Primary sections">
      <a href={homeHref}>Home</a>
      <a href={postsHref}>Posts</a>
      <a href={contactHref}>Contact</a>
    </nav>
    <div class="header__nav">
      {showSearch && (
        <button type="button" class="header__search-toggle" aria-label="Toggle search">
          <span class="header__search-icon">🔎</span>
        </button>
      )}
      {enableDarkMode && (
        <button type="button" class="header__theme-mode-switcher theme-mode-switcher" data-mode="light">
          <span class="theme-mode-switcher__icon icon-dark">🌙</span>
          <span class="theme-mode-switcher__icon icon-light">☀️</span>
        </button>
      )}
      <NavLinks navItems={navItems} />
      <LanguageSwitcher lang={lang} options={languageOptions} />
      <button type="button" class="header__menu-toggle" aria-label="Toggle menu">
        <span class="header__menu-icon">☰</span>
      </button>
    </div>
  </div>
</header>
